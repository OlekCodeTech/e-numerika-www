# E-Numerika – statyczny eksport Next.js (Apache / LiteSpeed)
RewriteEngine On

# HTTPS + bez www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://e-numerika.pl%{REQUEST_URI} [L,R=301]

# Stare adresy z WordPressa
RedirectMatch 301 ^/o-nas-uslugi-ksiegowe-e-numerika/?$ /o-nas/
RedirectMatch 301 ^/blog/?$ /porady-dla-przedsiebiorcow/
RedirectMatch 301 ^/cennik/?$ /uslugi-ksiegowe-cennik/
RedirectMatch 301 ^/witamy-na-blogu-naszego-biura-rachunkowego/?$ /porady-dla-przedsiebiorcow/
RedirectMatch 301 ^/404-2/?$ /
RedirectMatch 301 ^/feed/?$ /porady-dla-przedsiebiorcow/
RedirectMatch 301 ^/(category|tag|author)/.*$ /porady-dla-przedsiebiorcow/
RedirectMatch 301 ^/sitemap_index\.xml$ /sitemap.xml
RedirectMatch 301 ^/(post|page|category)-sitemap\.xml$ /sitemap.xml

# Adresy bez końcowego slasha -> ze slashem
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule ^(.*)$ /$1/ [L,R=301]

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
